---
// /canon — the canonical nodes. One home per load-bearing idea; everything
// else references the node and does not restate it. The index copy is the
// hand-written roster below; the markdown itself lives in docs/canonical/
// (and, for the razor-blade case, in src/content/open/), cited by path from
// distinction-physics and the RBF archive.
import { VERSION, BUILD } from '../../lib/version';
import GuidePanel from '../../components/GuidePanel.astro';

const NODES: { href: string; title: string; kind: string; blurb: string }[] = [
  { href: '/canon/the-selection-primitive', title: 'The selection primitive', kind: 'Canonical node',
    blurb: 'Ethics as selection over configurations, denominated against heat death — the subject of this whole work, stated once. §1 ruled; the two-primitives block (distinction detects difference, selection orders it) forming; the join of the two scales stated here for the first time and awaiting its ruling.' },
  { href: '/open/NOTES-razor-blade-case', title: 'The razor-blade case', kind: 'Canonical node',
    blurb: 'Why possibility space is measured globally and trajectory-long, never locally: letting a child play with razor blades widens the immediate option set and collapses the trajectory’s. The one-term detector, whose signature is a mixed sign pattern no lens can rescue. Published in the open, canonical from here.' },
  { href: '/canon/the-jeremy-vine-finding', title: 'The Jeremy Vine finding', kind: 'Canonical node',
    blurb: 'One sentence of Welsh — less than one, in fact — and, on Aran Jones’s testimony, a dampening effect on conflict arriving eighteen months later through people who were never present. The honest evidence ledger, and the inventory of what a rig would need before the mechanism could be expressed. Forming.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Canonical nodes — Configuration Economics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Sora:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
    <style is:global>
      :root { --void:#0a0a0c; --text-primary:#e8e8f0; --text-secondary:#a0a0b8; --text-muted:#606080; --accent:#4a9eff; --status-open:#3fb8c4; --font-display:'Cormorant Garamond',serif; --font-body:'Sora',sans-serif; --font-mono:'JetBrains Mono',monospace; }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { font-family:var(--font-body); background:var(--void); color:var(--text-primary); min-height:100vh; line-height:1.7; }
      .top-nav { position:fixed; top:0; left:0; right:0; height:56px; background:rgba(10,10,12,0.95); backdrop-filter:blur(12px); border-bottom:1px solid rgba(255,255,255,0.06); display:flex; align-items:center; gap:2rem; padding:0 2rem; z-index:100; }
      .nav-home { font-family:var(--font-display); font-size:1.125rem; color:var(--text-primary); text-decoration:none; }
      .nav-link { font-size:0.875rem; color:var(--text-secondary); text-decoration:none; }
      .nav-link:hover { color:var(--accent); }
      .nav-right { display:flex; align-items:center; gap:1rem; margin-left:auto; flex-wrap:wrap; }
      .nav-version { font-family:var(--font-mono); font-size:0.75rem; color:var(--accent); }
      .nav-build { font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); opacity:0.7; }
      main { max-width:820px; margin:0 auto; padding:100px 2rem 6rem; }
      @media (min-width:1101px) { main { margin-right:460px; } }
      h1 { font-family:var(--font-display); font-weight:500; font-size:2.6rem; margin:0 0 0.5rem; }
      .lede { color:var(--text-secondary); border-left:2px solid rgba(74,158,255,0.4); padding-left:1.2rem; margin:0 0 3rem; }
      .lede strong { color:var(--text-primary); font-weight:400; }
      .lede a { color:var(--accent); text-decoration:none; }
      .doc { display:block; text-decoration:none; border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:1.25rem 1.4rem; margin-bottom:1rem; transition:border-color 0.15s,background 0.15s; }
      .doc:hover { border-color:rgba(74,158,255,0.4); background:rgba(74,158,255,0.03); }
      .doc-kind { font-family:var(--font-mono); font-size:0.62rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--accent); }
      .doc-title { font-family:var(--font-display); font-size:1.4rem; color:var(--text-primary); margin:0.2rem 0 0.4rem; }
      .doc-blurb { color:var(--text-secondary); font-size:0.9rem; margin:0; }
      .note { color:var(--text-muted); font-size:0.85rem; margin-top:2.5rem; }
      .note code { font-family:var(--font-mono); font-size:0.78rem; }
    </style>
  </head>
  <body>
    <nav class="top-nav">
      <a href="/" class="nav-home">Configuration Economics</a>
      <div class="nav-right">
        <a href="/open" class="nav-link">Open work</a>
        <a href="/method" class="nav-link">Method</a>
        <a href="/explore" class="nav-link">Propositions</a>
        <a href="/motion" class="nav-link">Motion</a>
        <span class="nav-version">{VERSION}</span>
        <span class="nav-build">build {BUILD}</span>
      </div>
    </nav>
    <main>
      <h1>Canonical nodes</h1>
      <p class="lede">One canonical statement per load-bearing idea. <strong>Everything else references the node and does not restate it</strong> — the never-twice rule applied to our own ideas, so that correcting an idea in its node propagates the correction by citation. Each node carries its own settledness on its face, and climbs on <a href="/motion">/motion</a> when it earns it.</p>
      {NODES.map(d => (
        <a class="doc" href={d.href}>
          <span class="doc-kind">{d.kind}</span>
          <div class="doc-title">{d.title}</div>
          <p class="doc-blurb">{d.blurb}</p>
        </a>
      ))}
      <p class="note">Split convention, flagged rather than settled: two of these nodes live in <code>docs/canonical/</code> and one in <code>src/content/open/</code>, because the razor-blade case was deliberately published as an open note. Whether they should converge on one home is an open call; until then this page is the single place that names them all.</p>
    </main>
    <GuidePanel currentSection="Canonical nodes" />
  </body>
</html>
