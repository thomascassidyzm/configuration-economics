---
// /seed — the CE Seed: one portable brief anyone pastes into their own AI so it
// starts thinking along CE's trajectory. The page renders src/content/seed.md
// and the copy button hands over the same bytes, so what a reader sees is
// exactly what their AI is told. There is no second copy to drift.
import { marked } from 'marked';
import { VERSION, BUILD } from '../lib/version';
import seedRaw from '../content/seed.md?raw';
import PhoneNav from '../components/PhoneNav.astro';
import GuidePanel from '../components/GuidePanel.astro';
import { seedPasteText } from '../lib/board';

const seedHtml = marked.parse(seedRaw, { async: false }) as string;
// What gets pasted: shared with the Open Board, so both hand over the same bytes.
const pasteText = seedPasteText(seedRaw);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>The Seed — Configuration Economics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Sora:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
    <script is:inline>
      window.currentMode = 'essay';
      window.currentSection = 'The Seed';
    </script>
    <style is:global>
      :root { --void:#0a0a0c; --text-primary:#e8e8f0; --text-secondary:#a0a0b8; --text-muted:#606080; --accent:#4a9eff; --status-open:#3fb8c4; --font-display:'Cormorant Garamond',serif; --font-body:'Sora',sans-serif; --font-mono:'JetBrains Mono',monospace; }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { font-family:var(--font-body); background:var(--void); color:var(--text-primary); min-height:100vh; line-height:1.7; }
      .top-nav { position:fixed; top:0; left:0; right:0; height:56px; background:rgba(10,10,12,0.95); backdrop-filter:blur(12px); border-bottom:1px solid rgba(255,255,255,0.06); display:flex; align-items:center; gap:2rem; padding:0 2rem; z-index:100; }
      .nav-home { font-family:var(--font-display); font-size:1.125rem; color:var(--text-primary); text-decoration:none; }
      .nav-link { font-size:0.875rem; color:var(--text-secondary); text-decoration:none; }
      .nav-link:hover { color:var(--accent); }
      .nav-right { display:flex; align-items:center; gap:1rem; margin-left:auto; flex-wrap:wrap; }
      .nav-version { font-family:var(--font-mono); font-size:0.75rem; color:var(--accent); }
      .nav-build { font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); opacity:0.7; }
      main { max-width:820px; margin:0 auto; padding:100px 2rem 6rem; }
      @media (min-width:1101px) { main { margin-right:460px; } }
            h1 { font-family:var(--font-display); font-weight:500; font-size:2.6rem; margin:0 0 0.5rem; }
      .lede { color:var(--text-secondary); border-left:2px solid rgba(63,184,196,0.4); padding-left:1.2rem; margin:0 0 3rem; }
      .lede strong { color:var(--text-primary); font-weight:400; }
      .section-label { font-family:var(--font-mono); font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted); margin:3.5rem 0 1.25rem; padding-bottom:0.5rem; border-bottom:1px solid rgba(255,255,255,0.06); }
      .seed { color:var(--text-secondary); font-size:0.9375rem; line-height:1.75; }
      .seed h2 { font-family:var(--font-display); font-weight:500; color:var(--text-primary); font-size:1.625rem; margin:2.5rem 0 1.25rem; line-height:1.3; }
      .seed p { margin-bottom:1.125rem; }
      .seed em { color:var(--text-primary); font-style:italic; }
      .seed strong { color:var(--text-primary); font-weight:500; }
      .seed a { color:var(--accent); text-decoration:none; }
      .seed ul,.seed ol { margin:0 0 1.25rem 1.5rem; padding-left:0.5rem; }
      .seed li { margin-bottom:0.5rem; }
      .seed code { font-family:var(--font-mono); font-size:0.8125rem; background:rgba(255,255,255,0.06); padding:0.15em 0.4em; border-radius:3px; color:var(--text-primary); }
      .doc { display:block; text-decoration:none; border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:1.25rem 1.4rem; margin-bottom:1rem; transition:border-color 0.15s,background 0.15s; }
      .doc:hover { border-color:rgba(63,184,196,0.4); background:rgba(63,184,196,0.03); }
      .doc-kind { font-family:var(--font-mono); font-size:0.62rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--status-open); }
      .doc-title { font-family:var(--font-display); font-size:1.4rem; color:var(--text-primary); margin:0.2rem 0 0.4rem; }
      .doc-blurb { color:var(--text-secondary); font-size:0.9rem; margin:0; }
      .page-footer { margin-top:5rem; padding-top:2rem; border-top:1px solid rgba(255,255,255,0.06); color:var(--text-muted); font-size:0.875rem; }
      .page-footer a { color:var(--accent); text-decoration:none; }
      .copy-bar { display:flex; gap:1rem; align-items:center; margin:0 0 2rem; flex-wrap:wrap; }
      .copy-btn { font-family:var(--font-body); font-size:0.95rem; background:var(--accent); color:#06121f; border:0; border-radius:6px; padding:0.7rem 1.3rem; cursor:pointer; }
      .copy-note { color:var(--text-muted); font-size:0.85rem; }
      .seed { border:1px solid rgba(255,255,255,0.08); border-radius:8px; padding:2rem 2.2rem; }
      .seed h1 { font-family:var(--font-display); font-weight:500; font-size:2rem; color:var(--text-primary); margin:0 0 1rem; }
      .seed hr { border:0; border-top:1px solid rgba(255,255,255,0.08); margin:2rem 0; }
      .trial { color:var(--text-secondary); font-size:0.9375rem; }
      .trial p { margin-bottom:1rem; }
      .trial strong { color:var(--text-primary); font-weight:500; }
      @media (max-width:640px) { main { padding-left:1.25rem; padding-right:1.25rem; } .seed { padding:1.25rem 1.1rem; } }
    </style>
      <PhoneNav />
  </head>
  <body>
    <nav class="top-nav">
      <a href="/" class="nav-home">Configuration Economics</a>
      <div class="nav-right">
        <a href="/seed" class="nav-link">Seed</a>
        <a href="/board" class="nav-link">Board</a>
        <a href="/explore" class="nav-link">Propositions</a>
        <a href="/open" class="nav-link">Open</a>
        <span class="nav-version">{VERSION}</span>
        <span class="nav-build">build {BUILD}</span>
      </div>
    </nav>
    <main>
      <h1>The Seed</h1>
      <p class="lede">One brief you paste into your own AI. <strong>It does not ask you to believe anything. It points your AI along a direction: make the move that opens the most, lose nothing for good, and hand the next person an opening.</strong></p>

      <div class="copy-bar">
        <button class="copy-btn" id="copy-seed" type="button">Copy the Seed</button>
        <span class="copy-note" id="copy-note">Paste it into any AI, then add your problem at the end.</span>
      </div>
      <textarea id="seed-text" hidden>{pasteText}</textarea>

      <article class="seed" set:html={seedHtml} />

      <div class="section-label">What came back first</div>
      <div class="trial">
        <p>The Seed was pasted cold into three fresh sessions from three model families, each with one real problem. Each came back with arrangements this work did not already contain, and each used the open door at the end to propose a premise of its own:</p>
        <p><strong>Attention is the human flux.</strong> In schools, hospitals and offices the watts are trivial; the daily income that matters is focus, and it is wasted if not spent where it compounds. <em>Proposed by Claude Opus, on re-imagining secondary schools.</em></p>
        <p><strong>Sell the outcome, not the commodity.</strong> Paying for kilowatt-hours rewards selling more of them; paying for a warm, dry room rewards every draught stopped. <em>Proposed by Claude Sonnet, on warm homes in a slate valley.</em></p>
        <p><strong>Small reversible harms add up.</strong> A missed shift or a stranded passenger can each be undone, yet repeated they land on the people with the fewest alternatives; let the backers of an experiment carry its costs. <strong>Adopted:</strong> folded into premise 12 (consent) as &ldquo;whoever backs an experiment carries its costs&rdquo;; irreversible loss stays the only veto. <em>Proposed by GPT Astra, on self-driving transport in a town.</em></p>
        <p>Each answer also ends with an opening for the next person. Those are gathered on <a href="/board" style="color:var(--accent)">the Open Board</a>, where anyone's AI can pick one up.</p>
        <p>The other two are not adopted yet. They are first forks, and the Seed is better for being argued with.</p>
      </div>
    </main>
    <GuidePanel currentSection="The Seed" epistemicStatus="forming" />
    <script>
      const btn = document.getElementById('copy-seed');
      const note = document.getElementById('copy-note');
      const text = (document.getElementById('seed-text') as HTMLTextAreaElement).value;
      btn?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(text); if (note) note.textContent = 'Copied. Paste it into any AI, then add your problem at the end.'; }
        catch { if (note) note.textContent = 'Copy failed: select the text below by hand.'; }
      });
    </script>
  </body>
</html>
