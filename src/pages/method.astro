---
// /method — the Six-Hat evaluation method as a first-class, navigable surface.
//
// Distinct from the generic /open register: this page renders the method
// itself (NOTES-six-hat-method.md) and then curates every run, treatment, and
// sibling method that exists in src/content/open/ into one navigable list.
import { marked } from 'marked';
import { VERSION, BUILD } from '../lib/version';
import GuidePanel from '../components/GuidePanel.astro';

const modules = import.meta.glob('../content/open/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const bySlug: Record<string, string> = {};
for (const [path, content] of Object.entries(modules)) {
  const slug = path.split('/').pop()!.replace(/\.md$/, '');
  bySlug[slug] = content;
}

const methodContent = bySlug['NOTES-six-hat-method'];
const methodBody = methodContent.replace(/^#\s+.+$/m, '').trim();
const methodHtml = marked.parse(methodBody, { async: false }) as string;

const RUNS: { slug: string; title: string; kind: string; blurb: string }[] = [
  { slug: 'NOTES-ogwen-six-hats', title: 'The Ogwen six-hat run', kind: 'Evaluation',
    blurb: 'The first full Six-Thinking-Hats evaluation, published in full: White corrects, Yellow makes the case, Black finds the fracture, Green leaps. The two human seats left open.' },
  { slug: 'NOTES-ssi-six-hats', title: 'The SSi six-hat run — a strong failure', kind: 'Evaluation',
    blurb: 'The second run, and the first to come back decisively critical — of the author’s own company. Published unedited, because a Living Epistemic Work cannot cherry-pick. A strong failure: certain doors closed, for now. Now we’re learning.' },
  { slug: 'NOTES-saudi-legal-six-hats', title: 'The Saudi-legal six-hat run', kind: 'Evaluation',
    blurb: 'The method in the hardest domain yet — and its best work. It refused both the feel-good yes and the reflexive no: a clean positive-sum configuration exists, but cleanliness and scale are inversely correlated. The honest answer points at the exit, not the entrance.' },
  { slug: 'NOTES-autonomous-fleet-six-hats', title: 'The autonomous-fleet six-hat run', kind: 'Evaluation',
    blurb: 'The canon stress-tested. The frozen value is real — but the thaw and the re-freeze are the same motion: on the default configuration it re-freezes behind a private toll-gate. A greater-life-to-all version exists, won or lost at the per-city operating permit, racing a closing clock.' },
  { slug: 'NOTES-iterative-search-method', title: 'The iterative search-based loop', kind: 'Method',
    blurb: 'The six-hat method made iterative: search, not optimisation. Re-level → expand → find walls → classify each as frame-artefact or physical-invariant → loop, never settling for a compromise. The agents do the search; the human breaks the box. The method as a meta-tool.' },
  { slug: 'NOTES-iterative-search-mobility', title: 'The search loop re-levels the car problem', kind: 'Run',
    blurb: 'First outing. Fed the car run’s residual trade-offs, the loop re-leveled "cars" up to "access", dissolved four trade-offs onto a member-owned mutual pool, hit two genuine physical floors, and handed back exactly one box-stuck point: the enclosure-timing race.' },
  { slug: 'NOTES-ratchet-cell', title: 'The ratchet cell — the local-energy configuration', kind: 'Treatment',
    blurb: 'The first definite treatment: a nine-rung no-faith ladder from one household to a valley mutual — every rung individually rational, the cell a by-product, Bethesda entering mid-climb as the worked instance. Bridge-gated by three adversaries: passes-with-conditions, verdict printed in-surface.' },
  { slug: 'NOTES-second-commodity', title: 'The second commodity — mobility on the energy cell’s rails', kind: 'Treatment',
    blurb: 'The second definite treatment, and the diligence upgrade the mobility work was owed: evidence contradicted the prior run’s political lever, precipitation turns out to require rails (the cells compound), and the gate split the design — passing the eight-rung ladder while failing the AV-bargaining headline. Passes-with-conditions, printed in full.' },
  { slug: 'NOTES-forest-school-walton', title: 'The stowaway curriculum — forest school as the medium (Walton-on-Thames)', kind: 'Treatment',
    blurb: 'The third definite treatment, brought in from the field: forest delivery of the non-tested-but-mandatory curriculum routes around the SATs constraint entirely — literacy stows away as content, never timetable; one willing teacher per school; permission surface near zero. The evidence fleet was refused at the permissions wall, so the verdict is the gate’s weakest form — passes-on-paper — with the degradation printed, condition zero being the live re-run. The domain’s clock runs backwards: a window that opens (the 2028 curriculum reset), not one that closes.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Method — Configuration Economics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Sora:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
    <style is:global>
      :root { --void:#0a0a0c; --text-primary:#e8e8f0; --text-secondary:#a0a0b8; --text-muted:#606080; --accent:#4a9eff; --status-open:#3fb8c4; --font-display:'Cormorant Garamond',serif; --font-body:'Sora',sans-serif; --font-mono:'JetBrains Mono',monospace; }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { font-family:var(--font-body); background:var(--void); color:var(--text-primary); min-height:100vh; line-height:1.7; }
      .top-nav { position:fixed; top:0; left:0; right:0; height:56px; background:rgba(10,10,12,0.95); backdrop-filter:blur(12px); border-bottom:1px solid rgba(255,255,255,0.06); display:flex; align-items:center; gap:2rem; padding:0 2rem; z-index:100; }
      .nav-home { font-family:var(--font-display); font-size:1.125rem; color:var(--text-primary); text-decoration:none; }
      .nav-link { font-size:0.875rem; color:var(--text-secondary); text-decoration:none; }
      .nav-link:hover { color:var(--accent); }
      .nav-right { display:flex; align-items:center; gap:1rem; margin-left:auto; flex-wrap:wrap; }
      .nav-version { font-family:var(--font-mono); font-size:0.75rem; color:var(--accent); }
      .nav-build { font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); opacity:0.7; }
      main { max-width:820px; margin:0 auto; padding:100px 2rem 6rem; }
      @media (min-width:1101px) { main { margin-right:460px; } }
      h1 { font-family:var(--font-display); font-weight:500; font-size:2.6rem; margin:0 0 0.5rem; }
      .lede { color:var(--text-secondary); border-left:2px solid rgba(63,184,196,0.4); padding-left:1.2rem; margin:0 0 3rem; }
      .lede strong { color:var(--text-primary); font-weight:400; }
      .section-label { font-family:var(--font-mono); font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted); margin:3.5rem 0 1.25rem; padding-bottom:0.5rem; border-bottom:1px solid rgba(255,255,255,0.06); }
      .method-content { color:var(--text-secondary); font-size:0.9375rem; line-height:1.75; }
      .method-content h2 { font-family:var(--font-display); font-weight:500; color:var(--text-primary); font-size:1.625rem; margin:2.5rem 0 1.25rem; line-height:1.3; }
      .method-content p { margin-bottom:1.125rem; }
      .method-content em { color:var(--text-primary); font-style:italic; }
      .method-content strong { color:var(--text-primary); font-weight:500; }
      .method-content a { color:var(--accent); text-decoration:none; }
      .method-content ul,.method-content ol { margin:0 0 1.25rem 1.5rem; padding-left:0.5rem; }
      .method-content li { margin-bottom:0.5rem; }
      .method-content code { font-family:var(--font-mono); font-size:0.8125rem; background:rgba(255,255,255,0.06); padding:0.15em 0.4em; border-radius:3px; color:var(--text-primary); }
      .doc { display:block; text-decoration:none; border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:1.25rem 1.4rem; margin-bottom:1rem; transition:border-color 0.15s,background 0.15s; }
      .doc:hover { border-color:rgba(63,184,196,0.4); background:rgba(63,184,196,0.03); }
      .doc-kind { font-family:var(--font-mono); font-size:0.62rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--status-open); }
      .doc-title { font-family:var(--font-display); font-size:1.4rem; color:var(--text-primary); margin:0.2rem 0 0.4rem; }
      .doc-blurb { color:var(--text-secondary); font-size:0.9rem; margin:0; }
      .page-footer { margin-top:5rem; padding-top:2rem; border-top:1px solid rgba(255,255,255,0.06); color:var(--text-muted); font-size:0.875rem; }
      .page-footer a { color:var(--accent); text-decoration:none; }
    </style>
  </head>
  <body>
    <nav class="top-nav">
      <a href="/" class="nav-home">Configuration Economics</a>
      <div class="nav-right">
        <a href="/method" class="nav-link">Method</a>
        <a href="/explore" class="nav-link">Propositions</a>
        <a href="/motion" class="nav-link">Motion</a>
        <a href="/open" class="nav-link">Open</a>
        <span class="nav-version">{VERSION}</span>
        <span class="nav-build">build {BUILD}</span>
      </div>
    </nav>
    <main>
      <h1>Method</h1>
      <p class="lede">How proposals and artefacts are conceived and tested here. <strong>The de Bono hat sequence, run by an agent swarm, gated by a fitness function, with two seats kept irreducibly human — the Red gut check and the final Blue verdict.</strong> The apparatus is as transparent as the claims it evaluates.</p>

      <article class="method-content" set:html={methodHtml} />

      <div class="section-label">Every run and treatment</div>
      {RUNS.map(d => (
        <a class="doc" href={`/open/${d.slug}`}>
          <span class="doc-kind">{d.kind}</span>
          <div class="doc-title">{d.title}</div>
          <p class="doc-blurb">{d.blurb}</p>
        </a>
      ))}

      <footer class="page-footer"><p>See the full working register at <a href="/open">/open</a>, or the propositions themselves at <a href="/explore">/explore</a>.</p></footer>
    </main>
    <GuidePanel currentSection="Method" />
  </body>
</html>
