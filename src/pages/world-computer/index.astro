---
// /world-computer — the room, rebuilt as three seats and bounded runs.
//
// Galileo's Dialogue: Salviati argues the design, Sagredo is the intelligent
// outsider to be convinced (readers' questions enter through his seat),
// Simplicio is the conventional view at full strength, on a different model.
// A run is bounded like a training run: its budget is fixed before it starts
// and printed here, its loss is recomputed after every round, it stops early
// when the loss stops falling, and its checkpoint is scored by a held-out
// critic that never saw the thread. The note in /open moves only when a run
// moved it and the critic passed it.
//
// The thread is read live from the store the runner writes to; nothing here
// waits for a build. The six-hat sessions it grew out of are at /world-computer/hats.
import { VERSION, BUILD } from '../../lib/version';
import PhoneNav from '../../components/PhoneNav.astro';
import { getRun, listRuns } from '../../lib/run-store';
import type { Run } from '../../lib/run-store';
import SeatRun from '../../components/run/SeatRun.astro';
import HatRun from '../../components/run/HatRun.astro';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');

const ids = await listRuns();
const want = Astro.url.searchParams.get('run');
const runId = want && ids.includes(want) ? want : ids[ids.length - 1];
const run: Run | null = runId ? await getRun(runId) : null;

const LIVE_STATES = ['opening', 'running', 'closing', 'checkpointing', 'critic', 'dialogue'];
const live = !!run && LIVE_STATES.includes(run.state);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The world computer — Configuration Economics</title>
    <meta name="description" content="Three agents on three models think one design note through the six hats in public. Each hat is a bounded run with its own loss, one budget split by Blue, and the findings told as a Galileo dialogue." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Sora:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
    <PhoneNav />
  </head>
  <body>
    <nav class="top-nav">
      <a href="/" class="nav-home">Configuration Economics</a>
      <div class="nav-right">
        <a href="/world-computer/hats" class="nav-link">The six-hat sessions</a>
        <a href="/open" class="nav-link">Work</a>
        <a href="/method" class="nav-link">Method</a>
        <a href="/explore" class="nav-link">Propositions</a>
        <span class="nav-version">{VERSION}</span>
        <span class="nav-build">build {BUILD}</span>
      </div>
    </nav>

    <main>
      <header class="page-header">
        <p class="kicker">The world computer · six hats · bounded runs</p>
        {run ? (
          <>
            <h1>{run.title}</h1>
            <p class="lede">{run.question}</p>
            <p class="subject">Working on <a href={`/open/${run.noteSlug}`}>the design note</a> as it stood at <code>{run.noteSha}</code>.</p>
          </>
        ) : (
          <>
            <h1>The world computer</h1>
            <p class="lede">No run has started yet.</p>
          </>
        )}
      </header>

      <div id="live" data-run={run?.id ?? ''} data-updated={run?.updatedAt ?? ''} data-live={live ? '1' : '0'}>
      {run && (run.engine === 'hats' ? <HatRun run={run} live={!!live} /> : <SeatRun run={run} live={!!live} />)}
      </div>

      {run && live && (
        <section class="panel ask" aria-label="Ask the room">
          <h2>Ask the room</h2>
          <p>Your question goes to the agents at the start of their next round, under whatever hat they are wearing. Your text is not published and reaches no person.</p>
          <form id="ask">
            <textarea name="q" maxlength="400" rows="3" placeholder="What would you want the room to look at?" required></textarea>
            <button type="submit">Send it in</button>
            <p class="ask-msg" aria-live="polite"></p>
          </form>
        </section>
      )}

      <section class="how">
        <details>
          <summary>How a run works</summary>
          <ul>
            <li><strong>The engine is the six hats.</strong> Three agents on three different models wear the same hat together and take turns in one direction, building on each other. It is parallel thinking: nobody argues against anybody. Blue opens with the question and closes with the verdict. Red is Tom's gut, and it is left to him.</li>
            <li><strong>Each hat is one bounded run with its own loss.</strong> White counts unchecked facts, Yellow value not yet found, Black risks not yet found, Green alternatives not yet tried. A clerk recounts it after every round. A hat stops early when it stops adding, and ends in a checkpoint: its findings, frozen.</li>
            <li><strong>One budget per run</strong>, in money and in tokens, set before the start. Blue splits it across the hats with a reason for each. A hat that stops early returns what it did not spend to a pool, and Blue can move pool money to a hat whose loss is still falling. Every move is shown.</li>
            <li><strong>Research happens off the thread.</strong> A loop goes out to the web and comes back as one line with its sources; the whole loop is one tap away.</li>
            <li><strong>The dialogue is how the run is told, not how it thinks.</strong> After the hats, the findings are rendered as Galileo's three: Salviati presents, Sagredo asks as the outsider, Simplicio voices the Black hat at full strength.</li>
            <li><strong>Nothing publishes itself.</strong> The design note moves only when the run's checkpoint changed it and a held-out critic, which never saw the thread, passed it.</li>
          </ul>
        </details>
      </section>

      <section class="others">
        {ids.length > 1 && <p>Runs: {ids.map(id => <a href={`/world-computer?run=${id}`} class={id === runId ? 'on' : ''}>{id}</a>)}</p>}
        <p>The room grew out of <a href="/world-computer/hats">the six-hat sessions</a> of September 2026, kept as they ran. Data: <a href={`/api/run.json${run ? `?id=${run.id}` : ''}`}>/api/run.json</a>.</p>
      </section>
    </main>

    <script>
      // Follow a live run without a reload: poll the run's stamp and, when it
      // moves, swap in the freshly rendered #live block, keeping open the
      // details a reader has opened.
      const box = document.getElementById('live');
      async function tick() {
        if (!box || box.dataset.live !== '1') return;
        try {
          const r = await fetch(`/api/run.json?id=${box.dataset.run}`, { cache: 'no-store' });
          const j = await r.json();
          if (j.updatedAt && j.updatedAt !== box.dataset.updated) {
            const html = await (await fetch(location.href, { cache: 'no-store' })).text();
            const next = new DOMParser().parseFromString(html, 'text/html').getElementById('live');
            if (next) {
              const open = [...box.querySelectorAll('details[open]')].map(d => d.id).filter(Boolean);
              box.innerHTML = next.innerHTML;
              Object.assign(box.dataset, next.dataset);
              for (const id of open) document.getElementById(id)?.setAttribute('open', '');
              if (next.dataset.live !== '1') document.querySelector('.ask')?.remove();
            }
          }
        } catch { /* try again next tick */ }
        setTimeout(tick, 8000);
      }
      setTimeout(tick, 8000);

      const form = document.getElementById('ask') as HTMLFormElement | null;
      form?.addEventListener('submit', async e => {
        e.preventDefault();
        const msg = form.querySelector('.ask-msg')!;
        const q = (form.elements.namedItem('q') as HTMLTextAreaElement).value;
        msg.textContent = 'Sending…';
        try {
          const r = await fetch('/api/run-question', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: box?.dataset.run, q }) });
          const j = await r.json();
          msg.textContent = r.ok ? j.note : j.error;
          if (r.ok) form.reset();
        } catch { msg.textContent = 'That did not send. Try again in a moment.'; }
      });
    </script>

    <style is:global>
      :root { --void:#0a0a0c; --text-primary:#e8e8f0; --text-secondary:#a0a0b8; --text-muted:#707090; --accent:#4a9eff; --salviati:#4a9eff; --sagredo:#d9b25c; --simplicio:#c8796a; --good:#5fbf8f; --font-display:'Cormorant Garamond',serif; --font-body:'Sora',sans-serif; --font-mono:'JetBrains Mono',monospace; }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { font-family:var(--font-body); background:var(--void); color:var(--text-primary); min-height:100vh; line-height:1.65; }
      a { color:var(--accent); }
      .top-nav { position:fixed; top:0; left:0; right:0; height:56px; background:rgba(10,10,12,0.95); backdrop-filter:blur(12px); border-bottom:1px solid rgba(255,255,255,0.06); display:flex; align-items:center; gap:2rem; padding:0 2rem; z-index:100; }
      .nav-home { font-family:var(--font-display); font-size:1.125rem; color:var(--text-primary); text-decoration:none; }
      .nav-link { font-size:0.875rem; color:var(--text-secondary); text-decoration:none; }
      .nav-link:hover { color:var(--accent); }
      .nav-right { display:flex; align-items:center; gap:1rem; margin-left:auto; flex-wrap:wrap; }
      .nav-version { font-family:var(--font-mono); font-size:0.75rem; color:var(--accent); }
      .nav-build { font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); opacity:0.7; }
      main { max-width:720px; margin:0 auto; padding:96px 1.25rem 5rem; }

      .kicker { font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--text-muted); margin-bottom:0.6rem; }
      h1 { font-family:var(--font-display); font-weight:500; font-size:2.3rem; line-height:1.15; margin-bottom:0.8rem; }
      .lede { color:var(--text-secondary); border-left:2px solid rgba(74,158,255,0.45); padding-left:1rem; }
      .subject { font-size:0.82rem; color:var(--text-muted); margin-top:0.7rem; }
      code { font-family:var(--font-mono); font-size:0.8em; }
      .page-header { margin-bottom:1.6rem; }

      .status { display:flex; flex-wrap:wrap; gap:0.6rem; align-items:center; margin-bottom:1.2rem; }
      .pill { font-family:var(--font-mono); font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; padding:0.25rem 0.6rem; border-radius:3px; border:1px solid rgba(255,255,255,0.18); color:var(--text-secondary); }
      .pill.running, .pill.checkpointing, .pill.critic { color:var(--good); border-color:rgba(95,191,143,0.5); animation:pulse 2.4s ease-in-out infinite; }
      .pill.failed { color:#e0864a; border-color:rgba(224,134,74,0.5); }
      @keyframes pulse { 50% { opacity:0.55; } }
      .stop-reason { font-size:0.8rem; color:var(--text-muted); }

      .panel { border:1px solid rgba(255,255,255,0.09); border-radius:6px; padding:1rem 1.1rem; margin-bottom:1rem; background:rgba(255,255,255,0.015); }
      .panel h2, .thread-h { font-family:var(--font-display); font-weight:500; font-size:1.35rem; margin-bottom:0.5rem; }
      .h2-note { font-family:var(--font-mono); font-size:0.62rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-left:0.4rem; }
      .panel h3 { font-size:0.78rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin:0.8rem 0 0.3rem; font-weight:400; }
      .panel p, .panel li { font-size:0.88rem; color:var(--text-secondary); }
      .panel ul { padding-left:1.1rem; }
      .bar { height:8px; border-radius:4px; background:rgba(255,255,255,0.07); overflow:hidden; margin:0.3rem 0 0.6rem; }
      .fill { height:100%; background:var(--accent); }
      .figures strong { color:var(--text-primary); font-weight:500; }
      .caps { list-style:none; padding:0 !important; display:grid; gap:0.25rem; margin-top:0.6rem; }
      .caps li { font-size:0.82rem; }
      .caps span { display:inline-block; min-width:7.5rem; font-family:var(--font-mono); font-size:0.66rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); }
      .formula { font-family:var(--font-mono); font-size:0.72rem !important; color:var(--text-muted) !important; }
      .curve { width:100%; max-width:420px; height:auto; display:block; margin:0.5rem 0; }
      .curve .axis { stroke:rgba(255,255,255,0.12); }
      .curve .line { fill:none; stroke:var(--accent); stroke-width:2; }
      .curve .dot { fill:var(--accent); }
      .curve .val { fill:var(--text-primary); font-size:11px; text-anchor:middle; font-family:var(--font-mono); }
      .curve .tick { fill:var(--text-muted); font-size:9px; text-anchor:middle; font-family:var(--font-mono); }
      .now strong { color:var(--text-primary); }

      .seats { display:grid; grid-template-columns:repeat(3, 1fr); gap:0.5rem; margin:1.4rem 0 0.6rem; }
      .seat { border-top:2px solid var(--c); padding:0.5rem 0.2rem 0; }
      .seat.salviati { --c:var(--salviati); } .seat.sagredo { --c:var(--sagredo); } .seat.simplicio { --c:var(--simplicio); }
      .seat-name { font-family:var(--font-display); font-size:1.15rem; color:var(--c); margin-right:0.35rem; }
      .seat-model { font-family:var(--font-mono); font-size:0.62rem; color:var(--text-muted); }
      .seat-role { font-size:0.74rem; color:var(--text-secondary); line-height:1.4; margin-top:0.2rem; }
      .offstage { grid-column:1 / -1; font-size:0.76rem; color:var(--text-muted); margin-top:0.3rem; }
      @media (max-width:520px) { .seats { grid-template-columns:1fr; } .seat { display:block; } }

      .thread { margin:2rem 0 1.5rem; }
      .thread-h { margin-bottom:1rem; }
      .turn { border-left:2px solid var(--c, rgba(255,255,255,0.15)); padding:0.1rem 0 0.1rem 0.95rem; margin:0 0 1.6rem; }
      .turn.salviati { --c:var(--salviati); } .turn.sagredo { --c:var(--sagredo); } .turn.simplicio { --c:var(--simplicio); }
      .turn-head { display:flex; flex-wrap:wrap; align-items:baseline; gap:0.6rem; margin-bottom:0.35rem; }
      .who { font-family:var(--font-display); font-size:1.25rem; color:var(--c); }
      .meta { font-family:var(--font-mono); font-size:0.64rem; color:var(--text-muted); }
      .carried { font-size:0.75rem; color:var(--sagredo); font-style:italic; margin-bottom:0.3rem; }
      .body p { margin:0 0 0.7rem; font-size:0.94rem; }
      .body ul, .body ol { padding-left:1.2rem; margin-bottom:0.7rem; font-size:0.94rem; }
      .changes { list-style:none; margin-top:0.3rem; }
      .changes li { font-size:0.82rem; color:var(--text-secondary); padding:0.35rem 0.6rem; border:1px dashed rgba(74,158,255,0.35); border-radius:4px; margin-bottom:0.35rem; }
      .changes span { font-family:var(--font-mono); font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--accent); margin-right:0.5rem; }

      .research { margin:0 0 1.4rem 0.95rem; padding:0.6rem 0.8rem; border-radius:5px; background:rgba(95,191,143,0.05); border:1px solid rgba(95,191,143,0.22); }
      .research.pending { opacity:0.7; }
      .r-line { display:flex; gap:0.6rem; align-items:baseline; }
      .r-label { font-family:var(--font-mono); font-size:0.7rem; color:var(--good); }
      .r-by { font-size:0.68rem; color:var(--text-muted); }
      .r-answer { font-size:0.88rem; margin:0.2rem 0; }
      .r-sources { display:flex; flex-wrap:wrap; gap:0.25rem 0.8rem; font-size:0.72rem; }
      .research details { margin-top:0.35rem; }
      .research summary, .ledger summary, .checkpoint summary, .how summary { cursor:pointer; font-size:0.74rem; color:var(--text-muted); }
      .r-q, .r-full p { font-size:0.8rem; color:var(--text-secondary); margin:0.4rem 0; }
      .steps { padding-left:1.2rem; font-size:0.72rem; color:var(--text-muted); word-break:break-word; }
      .steps span { font-family:var(--font-mono); color:var(--good); }

      .ledger { margin:0 0 1.6rem; padding:0.45rem 0.7rem; border-top:1px solid rgba(255,255,255,0.08); border-bottom:1px solid rgba(255,255,255,0.08); }
      .ledger summary strong { color:var(--text-primary); font-size:0.9rem; }
      .l-k { font-family:var(--font-mono); font-size:0.64rem; text-transform:uppercase; letter-spacing:0.08em; margin-right:0.4rem; }
      .ledger h3 { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin:0.7rem 0 0.25rem; font-weight:400; }
      .ledger ul { list-style:none; }
      .ledger li { font-size:0.8rem; color:var(--text-secondary); margin-bottom:0.3rem; }
      .ledger li span { font-family:var(--font-mono); font-size:0.6rem; text-transform:uppercase; margin-right:0.45rem; padding:0.05rem 0.3rem; border-radius:2px; background:rgba(255,255,255,0.06); }
      .ledger li.st-open span, .ledger li.st-unchecked span, .ledger li.st-contradicted span { color:#e0864a; }
      .ledger li.st-answered span, .ledger li.st-conceded span, .ledger li.st-checked span { color:var(--good); }
      .ledger em { color:var(--text-muted); }
      .l-cost { font-family:var(--font-mono); font-size:0.62rem; color:var(--text-muted); margin-top:0.4rem; }
      .warn { color:#e0864a; font-size:0.78rem; }
      .none { font-size:0.8rem; color:var(--text-muted); }
      .waiting { font-size:0.8rem; color:var(--good); }

      .diff { font-family:var(--font-mono); font-size:0.68rem; line-height:1.5; white-space:pre-wrap; word-break:break-word; margin-top:0.5rem; max-height:70vh; overflow:auto; padding:0.5rem; background:rgba(0,0,0,0.3); border-radius:4px; }
      .diff .add { color:var(--good); display:block; background:rgba(95,191,143,0.07); }
      .diff .del { color:#e0864a; display:block; background:rgba(224,134,74,0.07); }
      .diff .hunk { color:var(--text-muted); display:block; }
      .critic.pass { border-color:rgba(95,191,143,0.45); }
      .critic.fail { border-color:rgba(224,134,74,0.45); }
      .verdict strong { color:var(--text-primary); }
      .moved { margin-top:0.7rem; }

      .ask textarea { width:100%; font:inherit; font-size:0.9rem; color:var(--text-primary); background:rgba(0,0,0,0.35); border:1px solid rgba(255,255,255,0.15); border-radius:4px; padding:0.6rem; margin:0.4rem 0; }
      .ask button { font:inherit; font-size:0.85rem; color:var(--void); background:var(--sagredo); border:none; border-radius:4px; padding:0.5rem 0.9rem; cursor:pointer; }
      .ask-msg { font-size:0.8rem; margin-top:0.4rem; }

      .how { margin:2rem 0 1rem; }
      .how ul { padding-left:1.1rem; margin-top:0.6rem; }
      .how li { font-size:0.85rem; color:var(--text-secondary); margin-bottom:0.5rem; }
      .how strong { color:var(--text-primary); font-weight:500; }
      .others p { font-size:0.8rem; color:var(--text-muted); margin-bottom:0.4rem; }
      .others a { margin-right:0.6rem; }
      .others a.on { color:var(--text-primary); }
    </style>
  </body>
</html>
