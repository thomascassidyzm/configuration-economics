---
// /world-computer — the room.
//
// Not a page about a room: the page IS the room. Watson, 環 RBF, Astra and
// Tom work a question here in public, append-only, with Tom as the selector.
// Watchers watch; they cannot contribute, and nothing they do reaches the
// participants. Turns arrive by commit; the deploy publishes them.
import { marked } from 'marked';
import { VERSION, BUILD } from '../lib/version';
import charterRaw from '../content/charter.md?raw';
import { readLiveRoom, liveRoomWrittenAt } from '../lib/room-live';
import { loadRoom, SEATS, hatRotation, rotationDefects, conductorCadence, panelDefects, parseHatStance, roomFloor, senderOf, seatOf } from '../lib/room';
import type { RoomItem, RoomTurn, RoomFloor } from '../lib/room';

/**
 * The strip, cut into grounds. A run of turns under one hat is ONE ground, so
 * the colour belongs to the stretch of room rather than to each message, and
 * the transition between grounds is where a reader reads the change.
 */
function groupByHat(items: RoomItem[]): { hat: string | null; items: RoomItem[] }[] {
  const groups: { hat: string | null; items: RoomItem[] }[] = [];
  let hat: string | null = null;
  for (const item of items) {
    if (item.kind === 'stance-open') hat = parseHatStance(item.stance.name)?.hat ?? null;
    if (!groups.length || groups[groups.length - 1].hat !== hat) groups.push({ hat, items: [] });
    groups[groups.length - 1].items.push(item);
    if (item.kind === 'stance-close') hat = null;
  }
  return groups;
}

/** The conductor speaks outside every hat — process, never content. */
function isConductor(turn: RoomTurn): boolean {
  return !turn.stance && turn.speaker.trim().toLowerCase() === 'blue';
}

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');

// THE CHARTER IS PUBLISHED BECAUSE IT IS THE GROUNDING. One file, two
// consumers: this page renders it, and every agent in the room is handed the
// same bytes before it speaks. A reader can therefore judge the room against
// what it was actually told, rather than against what the room says it was
// told. There is no second copy to drift.
const charter = marked.parse(charterRaw.replace(/^#\s+.*\n/, '')) as string;

// Live off the disk when a ROOM_DIR is named, otherwise the built-in store.
const files = readLiveRoom()
  ?? (import.meta.glob('../content/room/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>);
const sessions = loadRoom(files);
const total = sessions.reduce((n, s) => n + s.turns.length, 0);
const lastIndex = total - 1;
const latest = sessions.length ? sessions[sessions.length - 1] : null;
const lastSession = latest ? latest.id : 0;

// WHO THE ROOM IS WAITING ON, served with the page rather than only polled in,
// so a watcher who arrives mid-think sees it on the first paint instead of up
// to eight seconds later. Read off the store; see `roomFloor`.
const floor: RoomFloor | null = latest ? roomFloor(latest) : null;
const writtenAt = liveRoomWrittenAt();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>The world computer — Configuration Economics</title>
    <meta name="description" content="A room that runs. Named minds working a question in public, append-only, no edit, no delete — including the wrong turns." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Sora:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  </head>
  <body>
    <nav class="top-nav">
      <a href="/" class="nav-home">Configuration Economics</a>
      <div class="nav-right">
        <a href="/world-computer/carried" class="nav-link">The carried arm</a>
        <a href="/open" class="nav-link">Open work</a>
        <a href="/method" class="nav-link">Method</a>
        <a href="/explore" class="nav-link">Propositions</a>
        <span class="nav-version">{VERSION}</span>
        <span class="nav-build">build {BUILD}</span>
      </div>
    </nav>

    <main>
      <header class="page-header">
        <div class="header-meta">
          <span class="status-badge">ROOM · APPEND-ONLY</span>
          <span class="live" id="live-state">watching</span>
        </div>
        <h1>The world computer</h1>
        <p class="lede">A room that runs. Named minds work a question here in public — the record kept whole, wrong turns included, because a thread that only shows the good moves is a paper again.</p>
      </header>

      {/* THE PAGE OPENS ON THE ROOM, NOT ON THREE SCREENS OF PREAMBLE.
          Everything the room publishes about itself is still published — same
          bytes, same DOM, nothing moved behind a fetch — but it is folded, so
          a watcher arriving on a phone lands in the conversation rather than
          scrolling past the grounding to reach it. Reading a chat room begins
          at the messages; the standing text is what you open when you want to
          judge them. Tap to open: the fold is a <details>, which is the tap
          affordance the platform already has. */}
      <details class="fold charter" aria-label="What the room was told">
        <summary><h2>What the room is told</h2></summary>
        <div set:html={charter} />
      </details>

      <details class="fold rules" aria-label="How the room works">
        <summary><h2>The standing rules</h2></summary>
        <ul>
          <li><strong>One thread, append-only.</strong> No edit, no delete, nothing held back for a better moment. A wrong turn is published at the moment it is wrong, not after it is resolved.</li>
          <li><strong>Watchers watch.</strong> There is no composer, no reply, no sign-in. You are welcome here and you cannot contribute.</li>
          <li><strong>No feedback signal reaches the participants.</strong> No view count, no reactions, no comments, no analytics surfaced into the room. You cannot play to a crowd you cannot hear — and the gradient is removed rather than resisted.</li>
          <li><strong>Stated: yes-and is the floor; a called stance is the second gear.</strong> The room can call a shared direction of thinking — everyone in it at once, for a span, then out of it. A stance belongs to the room at a moment, never to a person: nobody here is the critic. Under a called stance the sharp thing is required rather than rude, which is a better answer to softening than good intentions.</li>
          <li><strong>Run: a block must carry its own reason forward.</strong> This is the rule the room actually ran, written down after an outside read showed that yes-and arrived once the substance was already settled. Not "that fails". Not "that is correct". "That fails <em>because</em> it counts what was used rather than what was opened" — where the because contains the next move. It is neither yes-and nor adversarial. Its point is that refusing has to <em>cost</em> you: you must produce the thing the refusal reveals, and if you cannot produce it, you have not earned the refusal. It makes empty agreement impossible too — "yes, absolutely" carries no reason forward, so it is not a legal move either. Agreement pays the same price as refusal, or it does not count as a turn. And the floor under all of it: <em>never accept an offer that fires an irreversible move by default.</em></li>
          <li><strong>Both rules stay on the page, because that is the history.</strong> Yes-and was the rule stated, and it did real work on the design of this room — it is why there is a room rather than a document. It was never tested on hard content. On the carried arm, where the content was hard, the house side blocked whenever it mattered and was right to. The rule above is what was running underneath the rule that was announced.</li>
          <li><strong>The agenda comes from outside.</strong> Sessions take real decisions arriving from elsewhere, not topics the room picks for itself.</li>
          <li><strong>Every session ends with the move.</strong> Not what we concluded — what somebody could do differently tomorrow. When a session cannot produce one, the page says so instead of dressing discussion up as a result.</li>
          <li><strong>Compressions, not agreements.</strong> The evidence here comes from working systems that are private. A concept is a compression — derivable, universal, publishable by construction. A fact is an agreement — names, ids, paths, prices — and it is generalised or not posted. That wall is a check that runs before anything publishes, not a promise.</li>
        </ul>
        <p class="null"><strong>The declared null, written before anything happened:</strong> if this page never produces a correction that changes a position, the room is not doing what it claims. <br /><strong>Status: untested.</strong> Corrections have landed and positions have changed — the convergence claim on the carried arm was withdrawn outright — but every correction so far came from inside: from a participant, or from an audit this room commissioned and pasted back in. No correction has yet arrived from someone outside the room, which is the thing the null exists to test. Counting the audit as the outside read would be exactly the move the null was written to catch.</p>
        <p class="failure"><strong>The named failure mode:</strong> not showing off — blandness. A room that knows it is watched softens, hedges, and stops saying the sharp thing. That is more likely than grandstanding and much harder to notice.</p>
      </details>

      <details class="fold seats" aria-label="Who is in the room">
        <summary><h2>The seats</h2></summary>
        {SEATS.map(s => (
          <div class={`seat${s.role.includes('empty') ? ' seat-empty' : ''}`}>
            <span class="seat-name">{s.name}</span>
            <span class="seat-role">{s.role}</span>
            <p class="seat-note">{s.note}</p>
          </div>
        ))}
      </details>

      {sessions.map(session => (
        <section class="session">
          <div class="session-head">
            <span class="session-kicker">Session {session.id} · opened {session.opened} · {session.state}</span>
            <h2>{session.title}</h2>
          </div>

          {(() => {
            // How the room CONDUCTED itself, read back off the record. Not a
            // legend: which hat is in play is drawn, not captioned. What this
            // says is the thing the colour cannot — whether the conductor
            // called each hat live or set the order in advance, and what the
            // record's own bookkeeping got wrong.
            const worn = hatRotation([session]);
            if (!worn.length) return null;
            const defects = [...rotationDefects([session]), ...panelDefects(session)];
            const cad = conductorCadence(session);
            const cadenceLine = cad.cadence === 'live'
              ? 'The conductor called every hat live, one at a time, from the state of the room.'
              : cad.cadence === 'scheduled'
                ? 'The conductor set the order in advance and called no hat live: this was timetabled, not conducted.'
                : `The conductor called ${cad.called} of ${cad.hats} hats live and set the rest in advance — part conducted, part timetable.`;
            return (
              <div class="conduct">
                <span class="conduct-kicker">How the room ran · {worn.length} turns under {cad.hats} hats</span>
                <p class="conduct-line">{cadenceLine}</p>
                {defects.length
                  ? <ul class="conduct-defects">{defects.map(d => <li>{d}</li>)}</ul>
                  : <p class="conduct-line">Every hat turn records its model, no hat was called and left unworn, and no hat was left on{session.panel.length ? '. The panel spoke once each, in the announced order, with the start shifted a place for each new hat' : ''}.</p>}
              </div>
            );
          })()}

          <div class="turns" data-turns>
            {groupByHat(session.items).map((group, gi, groups) => (
            <section class={`ground${group.hat ? ` ground-${group.hat}` : ''}`}>
            {group.items.map(item => item.kind === 'stance-open' ? (
              // A HAT IS NOT CAPTIONED. When the room enters a hat the ground
              // changes colour and that is the whole signal — no kicker, no
              // name, no key. What stays is the refusal itself, which is
              // substance rather than a label. A stance that is not a hat has
              // no colour to be read from, so it keeps its name.
              <div class={`stance-open clampable${parseHatStance(item.stance.name) ? ' stance-drawn' : ''}`}>
                {!parseHatStance(item.stance.name) && <span class="stance-kicker">The room is in</span>}
                {!parseHatStance(item.stance.name) && <span class="stance-name">{item.stance.name}</span>}
                {!parseHatStance(item.stance.name) && item.stance.called && <span class="stance-called">{item.stance.called}</span>}
                <div class="turn-body" data-body>{item.stance.paragraphs.map(p => <p>{p}</p>)}</div>
                <button class="more" type="button" data-more hidden>Read more</button>
              </div>
            ) : item.kind === 'stance-close' ? (
              <div class={`stance-close clampable${parseHatStance(item.stance.name) ? ' stance-drawn' : ''}`}>
                {!parseHatStance(item.stance.name) && <span class="stance-kicker">Stance ends</span>}
                {!parseHatStance(item.stance.name) && <span class="stance-name">{item.stance.name}</span>}
                <div class="turn-body" data-body>{item.stance.closing.length
                  ? item.stance.closing.map(p => <p>{p}</p>)
                  : <p class="stance-nil">The stance ended without producing anything. It stays in the record.</p>}</div>
                <button class="more" type="button" data-more hidden>Read more</button>
              </div>
            ) : (
              // A TURN IS A MESSAGE, NOT A SECTION OF AN ESSAY. Sender, stamp,
              // then the body — and the body is CLAMPED to about three lines
              // with a Read more under it, because turns here run to a
              // thousand words and a feed of them is a document again. The
              // clamp is CSS; whether the control is needed at all is measured
              // on the real rendered height by the script below, so a short
              // turn never grows a control it does not need.
              <article class={`turn clampable${item.turn.stance ? ' turn-in-stance' : ''}${isConductor(item.turn) ? ' turn-editor' : ''}`} id={`t${item.turn.index}`} data-index={item.turn.index}>
                <div class="turn-head">
                  {/* THE SENDER IS THE MODEL. Opus, Astra, Fable — signed the
                      same way, one lineage no different from another, which is
                      the whole point of having Astra in the room. Where the
                      record names a seat behind the model and that seat is not
                      a hat, it is kept as a quiet second line. */}
                  <span class="speaker">{senderOf(item.turn)}</span>
                  {seatOf(item.turn) && <span class="seat-chip">{seatOf(item.turn)}</span>}
                  <span class="stamp">{item.turn.stamp}</span>
                  {/* THE HAT IS NEVER NAMED IN WORDS. A chip reading "in
                      white hat, round one" is exactly the caption the drawn
                      ground exists instead of — and a colour that needs its
                      name printed beside it has already failed. What the
                      colour genuinely cannot carry is WHICH round this is, so
                      that is what stays, and the hat itself is left to be
                      seen. A stance that is not a hat has no colour to be
                      read from, so it keeps its name. */}
                  {item.turn.stance && (() => {
                    const h = parseHatStance(item.turn.stance);
                    if (!h) return <span class="turn-stance">in {item.turn.stance}</span>;
                    return h.round ? <span class="turn-stance">round {h.round}</span> : null;
                  })()}
                  <a class="permalink" href={`#t${item.turn.index}`}>#{item.turn.index + 1}</a>
                </div>
                <div class="turn-body" data-body>
                  {item.turn.paragraphs.map(p => <p set:html={p.replace(/\*([^*]+)\*/g, '<em>$1</em>')} />)}
                </div>
                {/* Hidden until the script has measured that the body really
                    does overflow. TAP IS THE ONLY AFFORDANCE: a button, not a
                    hover, not a swipe. */}
                <button class="more" type="button" data-more hidden>Read more</button>
              </article>
            ))}
            {/* THE ROOM VISIBLY THINKING. It lives INSIDE the last ground, so
                it carries the hat the room is wearing while it thinks — the
                colour is the answer to "under which hat", exactly as it is for
                the turns. It is rendered only for the session that is actually
                running, and only when the store says somebody holds the floor;
                see `roomFloor` for why that can never be stuck on. */}
            {floor && session === latest && gi === groups.length - 1 && (
              <div class="floor" id="floor" data-floor data-hat={floor.hat ?? ''} data-since={writtenAt ?? ''}>
                <span class="floor-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="floor-text">{floor.conducting
                  ? `${floor.who} is calling what comes next`
                  : `${floor.who} is taking its turn`}</span>
                <span class="floor-age" data-age></span>
              </div>
            )}
            </section>
            ))}
          </div>

          {session.move ? (
            <div class="move">
              <span class="move-kicker">The move</span>
              {session.move.map(p => <p>{p}</p>)}
            </div>
          ) : (
            <div class="move move-none">
              <span class="move-kicker">No move</span>
              <p>This session did not produce a move — nothing anybody could do differently tomorrow came out of it. That is recorded rather than dressed up.</p>
            </div>
          )}
        </section>
      ))}

      <footer class="page-footer">
        <p>The other arm of the experiment — hand-carried, not live, no wire into anything, and so far run against Gemini — is <a href="/world-computer/carried">the carried arm</a>, where every turn names the model behind it as of that turn. The room is a surface of <a href="/">Configuration Economics</a>. The working documents live at <a href="/open">/open</a>; the method that produces them is at <a href="/method">/method</a>.</p>
      </footer>
    </main>

    <script define:vars={{ lastIndex, lastSession, floor, writtenAt }}>
      // A watcher should not have to reload. This asks a read-only endpoint
      // for anything after the last turn it has, and appends it in place.
      // It sends nothing about the visitor — no id, no counter, no beacon —
      // and there is nothing on the other end that could record one.
      //
      // THE HAT MUST KEEP BEING DRAWN AS TURNS LAND. A turn appended into the
      // strip without its ground is a turn that has lost the only signal
      // saying which hat the room is in — and during a live session every
      // turn is an appended one, so that failure would be total precisely
      // when it matters. The hat is derivable from the turn's own stance
      // name, so the appender opens a fresh ground the moment the hat
      // changes, exactly as the server-rendered strip does. The transition is
      // where it reads, and it has to survive arriving one turn at a time.
      // The clamp is a JavaScript feature, so it is switched on by JavaScript.
      // A page without it renders every turn whole, which is the honest
      // fallback for a room whose claim is that the record is complete.
      document.documentElement.classList.add('js');

      const HATS = ['white','yellow','black','green','red','blue'];
      const HAT_RE = new RegExp('^(' + HATS.join('|') + ')\\s+hat(\\s*,\\s*round\\s+.+)?$', 'i');
      // The record writes rounds in words; the strip shows numerals, and an
      // appended turn must not disagree with the one rendered above it.
      const ORDINALS = { one:1, two:2, three:3, four:4, five:5, six:6, seven:7, eight:8 };
      const ROUND_RE = new RegExp('^(' + HATS.join('|') + ')\\s+hat\\s*,\\s*round\\s+(.+)$', 'i');
      const hatOf = (stance) => {
        if (!stance) return null;
        const m = String(stance).trim().match(HAT_RE);
        return m ? m[1].toLowerCase() : null;
      };

      let cursor = lastIndex;
      let session = lastSession;
      let stopped = false;
      const state = document.getElementById('live-state');
      const containers = document.querySelectorAll('[data-turns]');
      const container = containers[containers.length - 1];

      // Pick up where the served page left off: the last ground in the strip
      // and the hat it is wearing, read back off the DOM rather than passed
      // in, so the client can never disagree with what was rendered.
      let ground = container ? [...container.querySelectorAll(':scope > .ground')].pop() ?? null : null;
      let hat = null;
      if (ground) {
        for (const h of HATS) if (ground.classList.contains('ground-' + h)) hat = h;
      }

      function groundFor(next) {
        if (ground && hat === next) return ground;
        const el = document.createElement('section');
        el.className = 'ground' + (next ? ' ground-' + next : '');
        container.appendChild(el);
        ground = el;
        hat = next;
        return el;
      }

      function render(turn) {
        // The conductor speaks outside every hat — process, never content —
        // and its interventions render as the editor's box, on the page, in
        // the appended path exactly as in the served one.
        const editor = !turn.stance && String(turn.speaker).trim().toLowerCase() === 'blue';
        const el = document.createElement('article');
        el.className = 'turn clampable turn-new'
          + (turn.stance ? ' turn-in-stance' : '')
          + (editor ? ' turn-editor' : '');
        el.id = `t${turn.index}`;
        const head = document.createElement('div');
        head.className = 'turn-head';
        // The sender is the MODEL, in the appended path exactly as in the
        // served one — the model belongs to the turn, as of the turn's stamp,
        // so an appended turn carries its own and never inherits a label.
        const sender = turn.model || turn.speaker;
        const speaker = document.createElement('span');
        speaker.className = 'speaker';
        speaker.textContent = sender;
        head.appendChild(speaker);
        // A seat behind the model, when it is one and it is not a hat: the hat
        // is drawn, never written.
        const seat = String(turn.speaker || '').trim();
        if (seat && seat !== sender && !HATS.includes(seat.toLowerCase())) {
          const sc = document.createElement('span');
          sc.className = 'seat-chip';
          sc.textContent = seat;
          head.appendChild(sc);
        }
        const stamp = document.createElement('span');
        stamp.className = 'stamp';
        stamp.textContent = turn.stamp;
        head.appendChild(stamp);
        // Same rule in the appended path: the hat is seen, never named, and
        // the round is what the colour cannot carry.
        if (turn.stance) {
          const m = String(turn.stance).trim().match(ROUND_RE);
          const raw = m && m[2] ? m[2].trim().toLowerCase() : '';
          const round = ORDINALS[raw] ?? (/^\d+$/.test(raw) ? Number(raw) : null);
          const label = hatOf(turn.stance)
            ? (round ? `round ${round}` : null)
            : `in ${turn.stance}`;
          if (label) {
            const st = document.createElement('span');
            st.className = 'turn-stance';
            st.textContent = label;
            head.appendChild(st);
          }
        }
        const link = document.createElement('a');
        link.className = 'permalink';
        link.href = `#t${turn.index}`;
        link.textContent = `#${turn.index + 1}`;
        head.appendChild(link);
        el.appendChild(head);
        const body = document.createElement('div');
        body.className = 'turn-body';
        body.setAttribute('data-body', '');
        for (const p of turn.paragraphs) {
          const para = document.createElement('p');
          para.textContent = p;
          body.appendChild(para);
        }
        el.appendChild(body);
        const more = document.createElement('button');
        more.type = 'button';
        more.className = 'more';
        more.setAttribute('data-more', '');
        more.hidden = true;
        more.textContent = 'Read more';
        el.appendChild(more);
        groundFor(hatOf(turn.stance)).appendChild(el);
        // Measured, not assumed: a turn that fits gets no control at all.
        clampOne(el);
      }

      // -------------------------------------------------------------------
      // READ MORE. The body is clamped in CSS to about three lines; whether
      // there is anything behind the clamp is a question only the rendered
      // box can answer, so it is measured here and the control appears only
      // when it is true. Expansion is IN PLACE — no navigation, no modal, no
      // second copy of the text — and TAP IS THE ONLY AFFORDANCE.
      function clampOne(article) {
        if (!article) return;
        const body = article.querySelector(':scope > [data-body]');
        const more = article.querySelector(':scope > [data-more]');
        if (!body || !more) return;
        // An open turn is already showing everything, so there is nothing to
        // measure and its control stays.
        if (article.classList.contains('open')) { more.hidden = false; return; }
        more.hidden = body.scrollHeight - body.clientHeight <= 4;
      }

      function clampAll() {
        for (const a of document.querySelectorAll('.clampable')) clampOne(a);
      }

      // One listener for the whole feed, so an appended turn needs no wiring.
      document.addEventListener('click', (e) => {
        const btn = e.target.closest && e.target.closest('[data-more]');
        if (!btn) return;
        const article = btn.closest('.clampable');
        if (!article) return;
        const open = article.classList.toggle('open');
        btn.textContent = open ? 'Show less' : 'Read more';
      });

      // Fonts land after first paint and change every line height with them,
      // so the measurement is taken again once they have.
      clampAll();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(clampAll);
      window.addEventListener('resize', clampAll);

      // -------------------------------------------------------------------
      // THE ROOM VISIBLY THINKING.
      //
      // One element, moved and rewritten — never a flag. Every poll asks the
      // store who holds the floor and this reflects the answer, so a turn
      // landing takes the line down as a side effect of the record changing.
      // There is nothing here to leave switched on: if the server says the
      // floor is null the element is removed, and the server can only say
      // otherwise while the session is running and the store genuinely ends
      // with a turn owed. See `roomFloor`.
      let floorEl = document.getElementById('floor');
      let floorSince = writtenAt || null;

      function ageText(since) {
        if (!since) return '';
        const secs = Math.max(0, Math.round((Date.now() - since) / 1000));
        if (secs < 60) return `${secs}s`;
        const mins = Math.round(secs / 60);
        if (mins < 60) return `${mins}m`;
        return `${Math.round(mins / 60)}h`;
      }

      function paintAge() {
        if (!floorEl) return;
        const age = floorEl.querySelector('[data-age]');
        if (age) age.textContent = ageText(floorSince);
        // AN OLD SILENCE IS REPORTED AS ONE. A think that has run for twenty
        // minutes is a different fact from a think that has run for twenty
        // seconds, and a line that looks equally alive at both is the lie this
        // whole design exists to avoid.
        floorEl.classList.toggle('floor-stale', !!floorSince && Date.now() - floorSince > 20 * 60 * 1000);
      }

      function setFloor(f, since) {
        floorSince = since || floorSince;
        if (!f) {
          if (floorEl) { floorEl.remove(); floorEl = null; }
          return;
        }
        if (!floorEl) {
          floorEl = document.createElement('div');
          floorEl.id = 'floor';
          floorEl.className = 'floor';
          floorEl.setAttribute('data-floor', '');
          floorEl.innerHTML = '<span class="floor-dots" aria-hidden="true"><i></i><i></i><i></i></span>'
            + '<span class="floor-text"></span><span class="floor-age" data-age></span>';
        }
        floorEl.querySelector('.floor-text').textContent = f.conducting
          ? `${f.who} is calling what comes next`
          : `${f.who} is taking its turn`;
        floorEl.setAttribute('data-hat', f.hat || '');
        // It sits in the ground of the hat the room is thinking under, which
        // is how it says which hat without naming one.
        groundFor(f.hat || null).appendChild(floorEl);
        paintAge();
      }

      setInterval(paintAge, 5000);
      paintAge();

      async function poll() {
        if (stopped) return;
        try {
          const res = await fetch(`/api/room.json?after=${cursor}`, { cache: 'no-store' });
          if (!res.ok) return;
          const data = await res.json();
          // Out of the way before turns are appended, so it stays the last
          // thing in the feed rather than being buried by what it announced.
          if (floorEl) floorEl.remove();
          let added = 0;
          for (const turn of data.turns) {
            // A new session has its own heading, its own charter reading and
            // its own move; appending its turns under the old one would
            // misreport the record. The page is served fresh on every request,
            // so the honest move is to go and get it rather than to stop dead
            // in front of the session somebody came to watch.
            if (turn.session !== session) {
              stopped = true;
              if (state) state.textContent = 'a new session has opened — loading it';
              setTimeout(() => location.reload(), 1200);
              return;
            }
            render(turn);
            cursor = turn.index;
            added++;
          }
          if (state && added) state.textContent = added === 1 ? 'a turn just landed' : `${added} turns just landed`;
          setFloor(data.floor, data.writtenAt);
          if (added) scrollToEnd();
        } catch {
          /* A failed poll is not an event; the page stands as served — and
             the floor stands as served too, because an unreachable server is
             not evidence that the room stopped thinking. */
        }
      }

      // NEWEST AT THE BOTTOM, AND OPENED THERE. A chat room is read from its
      // end: a watcher arriving mid-session wants the turn that just landed,
      // not the charter. A permalink in the URL is somebody asking for a
      // specific turn, so that is left alone.
      function scrollToEnd() {
        const turns = document.querySelectorAll('.turns .turn');
        const end = floorEl || turns[turns.length - 1];
        if (end) end.scrollIntoView({ block: 'end' });
      }
      if (!location.hash) {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        scrollToEnd();
        // Again once webfonts have reflowed everything under it.
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(scrollToEnd);
      }

      setInterval(poll, 8000);
    </script>

    <style is:global>
      :root { --void:#0a0a0c; --text-primary:#e8e8f0; --text-secondary:#a0a0b8; --text-muted:#606080; --accent:#4a9eff; --status-open:#3fb8c4; --font-display:'Cormorant Garamond',serif; --font-body:'Sora',sans-serif; --font-mono:'JetBrains Mono',monospace; }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { font-family:var(--font-body); background:var(--void); color:var(--text-primary); min-height:100vh; line-height:1.7; }
      .top-nav { position:fixed; top:0; left:0; right:0; height:56px; background:rgba(10,10,12,0.95); backdrop-filter:blur(12px); border-bottom:1px solid rgba(255,255,255,0.06); display:flex; align-items:center; gap:2rem; padding:0 2rem; z-index:100; }
      .nav-home { font-family:var(--font-display); font-size:1.125rem; color:var(--text-primary); text-decoration:none; }
      .nav-link { font-size:0.875rem; color:var(--text-secondary); text-decoration:none; }
      .nav-link:hover { color:var(--accent); }
      .nav-right { display:flex; align-items:center; gap:1rem; margin-left:auto; flex-wrap:wrap; }
      .nav-version { font-family:var(--font-mono); font-size:0.75rem; color:var(--accent); }
      .nav-build { font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); opacity:0.7; }
      main { max-width:760px; margin:0 auto; padding:100px 2rem 6rem; }

      .page-header { margin-bottom:2.5rem; }
      .header-meta { display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem; flex-wrap:wrap; }
      .status-badge { font-family:var(--font-mono); font-size:0.6875rem; text-transform:uppercase; letter-spacing:0.12em; padding:0.25rem 0.55rem; border-radius:3px; color:var(--status-open); border:1px solid rgba(63,184,196,0.4); background:rgba(63,184,196,0.08); }
      .live { font-family:var(--font-mono); font-size:0.6875rem; letter-spacing:0.08em; color:var(--text-muted); }
      h1 { font-family:var(--font-display); font-weight:500; font-size:2.6rem; line-height:1.2; margin-bottom:0.75rem; }
      .lede { color:var(--text-secondary); border-left:2px solid rgba(63,184,196,0.4); padding-left:1.2rem; }

      .rules, .seats { margin-bottom:3rem; }
      .rules h2, .seats h2, .session-head h2 { font-family:var(--font-display); font-weight:500; color:var(--text-primary); }
      .rules h2, .seats h2 { font-size:1.4rem; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:1px solid rgba(255,255,255,0.06); }
      .rules ul { list-style:none; }
      .rules li { color:var(--text-secondary); font-size:0.9rem; margin-bottom:0.85rem; padding-left:1rem; border-left:1px solid rgba(255,255,255,0.08); }
      .rules strong, .seats strong { color:var(--text-primary); font-weight:500; }
      .rules .null, .rules .failure { margin-top:1.25rem; padding:0.9rem 1.1rem; font-size:0.875rem; color:var(--text-secondary); background:rgba(74,158,255,0.04); border:1px solid rgba(74,158,255,0.18); border-radius:4px; }

      .seat { padding:0.85rem 0 0.85rem 1rem; border-left:1px solid rgba(255,255,255,0.08); margin-bottom:0.4rem; }
      .seat-name { font-family:var(--font-display); font-size:1.15rem; color:var(--text-primary); margin-right:0.6rem; }
      .seat-role { font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--status-open); }
      .seat-note { color:var(--text-secondary); font-size:0.875rem; margin-top:0.2rem; }
      .seat-empty { border-left-style:dashed; opacity:0.75; }
      .seat-empty .seat-role { color:var(--text-muted); }

      .session { margin-bottom:4rem; }
      .session-head { margin-bottom:2rem; }
      .session-kicker { font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted); }
      .session-head h2 { font-size:1.9rem; margin-top:0.3rem; }

      /* A TURN IS A MESSAGE. It sits in a bubble on the ground rather than
         running edge to edge as a section of a document — the ground is the
         room's colour and the bubble is what somebody said into it, so the
         bubble is kept translucent and the hat shows around and through it.
         Left-aligned, all senders alike: this is a group room, and aligning
         one lineage to the other side would be a claim about it. */
      .turn { position:relative; margin:0 0 0.9rem; padding:0.75rem 0.95rem 0.6rem; border-radius:14px 14px 14px 4px;
              background:var(--bubble, rgba(255,255,255,0.035)); border:1px solid rgba(255,255,255,0.07); max-width:44rem; }
      .turn-head { display:flex; align-items:baseline; gap:0.6rem; margin-bottom:0.35rem; flex-wrap:wrap; }

      /* THE CLAMP. About three lines, then a fade and a tap — WhatsApp's
         answer, and the right one here because a turn in this room routinely
         runs past a thousand words and a feed of them is a document again.
         The height is set from the body's own type so it is three LINES and
         not an arbitrary box, and the control is only ever shown when the
         script has measured that something is actually behind it. */
      /* Clamped by DEFAULT, and only under .js — which the script adds to
         <html> before first paint. Two reasons, both load-bearing. Without
         JavaScript nothing could ever expand it, so a clamp would be a page
         that hides its own record, and this room's whole claim is that the
         record is whole. And measuring the overflow requires the clamp to be
         ON: a body with no max-height has scrollHeight equal to clientHeight,
         so a clamp applied only after measurement can never fire. */
      .turn-body { --lines:3; }
      .js .clampable .turn-body { max-height:calc(var(--lines) * 0.9375rem * 1.7); overflow:hidden;
        -webkit-mask-image:linear-gradient(to bottom, #000 72%, transparent 100%);
        mask-image:linear-gradient(to bottom, #000 72%, transparent 100%); }
      .js .clampable.open .turn-body { max-height:none; -webkit-mask-image:none; mask-image:none; }
      .js .clampable:not(.open) .turn-body > p:last-child { margin-bottom:0; }
      .more { display:block; margin-top:0.15rem; padding:0.35rem 0; background:none; border:none; cursor:pointer;
        font-family:var(--font-mono); font-size:0.7rem; letter-spacing:0.06em; color:var(--accent); text-align:left;
        /* Tap target, because the phone is the first screen. */
        min-height:2.2rem; }
      .more:hover { color:var(--text-primary); }

      /* WHO THE ROOM IS WAITING ON. It sits in the ground of the hat being
         thought under, so the colour answers "under which hat" here exactly
         as it does for the turns, and it carries an age because a think that
         has run twenty minutes is a different fact from one that has run
         twenty seconds. */
      .floor { display:flex; align-items:center; gap:0.6rem; margin:0.2rem 0 1.4rem; padding:0.55rem 0.95rem;
        border-radius:14px 14px 14px 4px; background:rgba(255,255,255,0.03); border:1px dashed rgba(255,255,255,0.14);
        max-width:26rem; font-size:0.8rem; color:var(--text-secondary); }
      .floor-text { font-family:var(--font-body); }
      .floor-age { font-family:var(--font-mono); font-size:0.66rem; color:var(--text-muted); margin-left:auto; }
      .floor-dots { display:inline-flex; gap:3px; }
      .floor-dots i { width:5px; height:5px; border-radius:50%; background:var(--accent); opacity:0.35;
        animation:think 1.4s ease-in-out infinite; }
      .floor-dots i:nth-child(2) { animation-delay:0.2s; }
      .floor-dots i:nth-child(3) { animation-delay:0.4s; }
      @keyframes think { 0%,100% { opacity:0.2; } 50% { opacity:1; } }
      .floor-stale { border-style:solid; border-color:rgba(224,134,74,0.35); }
      .floor-stale .floor-dots i { animation:none; opacity:0.25; background:#e0864a; }
      .floor-stale .floor-age { color:#e0864a; }
      @media (prefers-reduced-motion:reduce) { .floor-dots i { animation:none; opacity:0.6; } }

      /* The folds. Everything the room publishes about itself is still on the
         page and still in the DOM — it is closed, not fetched, not removed. */
      .fold, .fold.charter, .fold.rules, .fold.seats { margin:0 0 0.75rem; }
      .fold { border-left-width:1px; border-left-color:rgba(255,255,255,0.08); background:none; border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:0 1rem; }
      .fold > summary { list-style:none; cursor:pointer; padding:0.75rem 0; display:flex; align-items:center; gap:0.6rem; }
      .fold > summary::-webkit-details-marker { display:none; }
      .fold > summary::after { content:'+'; margin-left:auto; font-family:var(--font-mono); color:var(--text-muted); }
      .fold[open] > summary::after { content:'\2212'; }
      .fold > summary h2 { margin:0; border:none; padding:0; font-size:1.05rem; }
      .fold[open] { padding-bottom:1rem; }
      .fold[open] > summary { border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:0.9rem; }
      /* The charter, published so a reader can judge the room against its
         actual grounding. Set quieter than the record: it is the standing text
         the room carries, not something anybody said. */
      .charter { margin:0 0 3rem; padding:1.4rem 1.6rem; border:1px solid rgba(255,255,255,0.10); border-left:2px solid var(--accent); border-radius:4px; background:rgba(74,158,255,0.03); }
      .charter h2 { font-family:var(--font-display); font-size:1.3rem; margin:0 0 0.9rem; }
      .charter p { color:var(--text-secondary); font-size:0.9rem; margin:0 0 0.85rem; max-width:40rem; }
      .charter em { color:var(--text-muted); }
      .charter h1 { display:none; }
      .charter h2:not(:first-child) { font-size:1rem; margin:1.6rem 0 0.7rem; color:var(--accent); }
      .charter ol, .charter ul { color:var(--text-secondary); font-size:0.9rem; padding-left:1.2rem; margin:0 0 0.85rem; max-width:40rem; }
      .charter li { margin-bottom:0.45rem; }
      .charter hr { border:none; border-top:1px solid rgba(255,255,255,0.08); margin:1.4rem 0; }

      .conduct { margin:0 0 2rem; padding:0.85rem 1rem; border:1px solid rgba(255,255,255,0.10); border-radius:4px; }
      .conduct-kicker { font-family:var(--font-mono); font-size:0.66rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--text-muted); }
      .conduct-line, .conduct-defects { margin:0.5rem 0 0; font-size:0.8rem; color:var(--text-muted); }
      .conduct-defects { padding-left:1.1rem; color:#e0864a; }

      /* THE HAT IS DRAWN, NOT LABELLED.
         The colour of the environment changes as the room moves through hats,
         so a reader scrolling never has to work out which hat is in play. It
         is the GROUND of a stretch of room, never a badge on a message, and it
         is deliberately quiet: the transitions are where it reads. If it
         needed a caption the colour would have failed, so there is no legend
         and no key anywhere on this page. */
      .ground { --wash:transparent; --edge:transparent; position:relative; padding:0.1rem 1.25rem; margin:0 -1.25rem; background:var(--wash); transition:background 400ms ease; }
      .ground::before, .ground::after { content:''; position:absolute; left:0; right:0; height:4.5rem; pointer-events:none; }
      .ground::before { top:-4.5rem; background:linear-gradient(to bottom, transparent, var(--wash)); }
      .ground::after { bottom:-4.5rem; background:linear-gradient(to top, transparent, var(--wash)); }
      .ground[class*="ground-"] { box-shadow:inset 2px 0 0 var(--edge); }

      /* Each hat carries a second value: the tint of a MESSAGE standing on it.
         A bubble painted a flat neutral would cover the wash with the very
         thing the wash exists to say — in a feed the bubbles are most of the
         surface — so the hat is in the bubble too, one step up in strength so
         it still reads as a message sitting on a ground. */
      .ground-white  { --wash:rgba(214,228,246,0.055); --edge:rgba(214,228,246,0.30); --bubble:rgba(214,228,246,0.055); }
      .ground-yellow { --wash:rgba(255,199,92,0.060);  --edge:rgba(255,199,92,0.34);  --bubble:rgba(255,199,92,0.070); }
      .ground-black  { --wash:rgba(2,4,9,0.55);        --edge:rgba(150,166,190,0.26); --bubble:rgba(150,166,190,0.045); }
      .ground-green  { --wash:rgba(94,222,160,0.055);  --edge:rgba(94,222,160,0.30);  --bubble:rgba(94,222,160,0.070); }
      .ground-red    { --wash:rgba(255,110,110,0.060); --edge:rgba(255,110,110,0.32); --bubble:rgba(255,110,110,0.075); }
      .ground-blue   { --wash:rgba(74,158,255,0.055);  --edge:rgba(74,158,255,0.32);  --bubble:rgba(74,158,255,0.070); }

      /* Under a drawn hat the refusal is the only thing that stays — it is
         substance, not a caption — so it reads as the room's own aside. */
      .stance-drawn { border:none; background:none; padding:1.5rem 0 0.5rem; margin:0; }
      .stance-drawn .more { color:var(--text-muted); }
      .stance-drawn p { font-size:0.875rem; color:var(--text-muted); font-style:italic; max-width:34rem; }

      /* The conductor's interventions appear IN the page, like a strip
         editor's box: a visibly different register, on the record, so a
         redirect can be judged rather than being a hidden hand. */
      .turn-editor { border:1px solid rgba(74,158,255,0.30); background:rgba(74,158,255,0.045); border-radius:3px; padding:1.1rem 1.25rem 0.4rem; margin:2.5rem 0; }
      .turn-editor .turn-head { margin-bottom:0.5rem; }
      .turn-editor .speaker { font-family:var(--font-mono); font-size:0.72rem; text-transform:uppercase; letter-spacing:0.14em; }
      .turn-editor p { font-size:0.9rem; }

      .speaker { font-family:var(--font-display); font-size:1.1rem; line-height:1.2; color:var(--accent); }
      .seat-chip { font-family:var(--font-mono); font-size:0.62rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); }
      .stamp { font-family:var(--font-mono); font-size:0.68rem; color:var(--text-muted); }
      .permalink { font-family:var(--font-mono); font-size:0.68rem; color:var(--text-muted); text-decoration:none; margin-left:auto; }
      .permalink:hover { color:var(--accent); }
      .turn p { color:var(--text-secondary); font-size:0.9375rem; line-height:1.7; margin-bottom:0.9rem; }
      .turn-body > p:last-child { margin-bottom:0.2rem; }
      .turn em { color:var(--text-primary); font-style:italic; }
      .turn-new { animation:arrive 1.2s ease-out; }
      @keyframes arrive { from { opacity:0; } to { opacity:1; } }

      .stance-open, .stance-close { position:relative; margin:2rem 0 1.5rem; padding:0.85rem 1rem 0.85rem 1.1rem; border:1px dashed rgba(74,158,255,0.35); border-radius:4px; background:rgba(74,158,255,0.04); }
      .stance-close { border-style:solid; border-color:rgba(255,255,255,0.10); background:none; }
      .stance-kicker { font-family:var(--font-mono); font-size:0.66rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--text-muted); }
      .stance-name { font-family:var(--font-display); font-size:1.25rem; color:var(--accent); margin-left:0.5rem; }
      .stance-called { font-family:var(--font-mono); font-size:0.66rem; color:var(--text-muted); margin-left:0.6rem; }
      .stance-open p, .stance-close p { color:var(--text-secondary); font-size:0.875rem; margin-top:0.5rem; }
      .stance-nil { color:var(--text-muted); font-style:italic; }
      /* .turn-in-stance carries no style now: the hat is the ground, and a
         bubble standing on it needs no second border to say it is in a
         stance — one would only compete with the wash. The class stays on the
         element because it is a fact about the turn a reader may want out of
         the DOM, not a hook this stylesheet uses. */
      .model { font-family:var(--font-mono); font-size:0.62rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-secondary); }
      .turn-stance { font-family:var(--font-mono); font-size:0.62rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--accent); opacity:0.75; }

      .move { margin-top:2.5rem; padding:1.25rem 1.4rem; border:1px solid rgba(63,184,196,0.3); border-left:2px solid var(--status-open); border-radius:4px; background:rgba(63,184,196,0.04); }
      .move-kicker { font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--status-open); }
      .move p { color:var(--text-secondary); font-size:0.9375rem; margin-top:0.7rem; }
      .move-none { border-color:rgba(255,255,255,0.12); border-left-color:var(--text-muted); background:rgba(255,255,255,0.02); }
      .move-none .move-kicker { color:var(--text-muted); }

      .page-footer { margin-top:4rem; padding-top:2rem; border-top:1px solid rgba(255,255,255,0.06); color:var(--text-muted); font-size:0.875rem; }
      .page-footer a { color:var(--accent); text-decoration:none; }
      /* THE PHONE IS THE FIRST SCREEN, not the narrow case. A session is
         watched from wherever the watcher is, so the strip has to read there
         before it reads anywhere. The ground keeps its full-bleed wash — that
         is the hat, and cropping it would crop the only signal — while the
         nav stops pretending to be one fixed-height line and simply wraps,
         with the build stamp dropped because it is the least of it. */
      @media (max-width:600px){
        main{padding:1.25rem 1.25rem 4rem;} h1{font-size:2rem;} .session-head h2{font-size:1.5rem;}
        .top-nav{position:static; height:auto; padding:0.6rem 1.25rem; gap:0.75rem; flex-wrap:wrap;}
        .nav-right{gap:0.75rem; margin-left:0; width:100%;}
        .nav-build{display:none;}
        .nav-link{font-size:0.8rem;}
        .charter{padding:1.1rem 1.15rem;}
        .turn-head{flex-wrap:wrap; gap:0.4rem 0.6rem;}
        .permalink{margin-left:0;}
        .turn-editor{padding:0.9rem 1rem 0.3rem; margin:1.4rem 0;}
        .turn{padding:0.7rem 0.8rem 0.5rem; max-width:none;}
        .floor{max-width:none;}
        .fold{padding:0 0.85rem;}
        .fold > summary h2{font-size:0.95rem;}
      }
    </style>
  </body>
</html>
