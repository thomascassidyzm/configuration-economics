      .chip { font-family:var(--font-mono); font-size:0.62rem; letter-spacing:0.08em; padding:0.1rem 0.45rem; border-radius:3px; border:1px solid rgba(74,158,255,0.4); color:var(--accent); text-transform:uppercase; }
      .chip-live { border-color:rgba(94,222,160,0.5); color:var(--hat-green); }
