      .more { display:block; margin-top:0.1rem; padding:0.35rem 0; background:none; border:none; cursor:pointer;
        font-family:var(--font-mono); font-size:0.7rem; letter-spacing:0.06em; color:var(--accent); text-align:left; min-height:2.2rem; }
      .more:hover { color:var(--text-primary); }
      .outcome .more { color:var(--text-secondary); }

      /* WHO THE ROOM IS WAITING ON. */
      .floor { display:flex; align-items:center; gap:0.6rem; margin:0.2rem 0 1rem; padding:0.55rem 0.95rem;
        border-radius:12px 12px 12px 4px; background:rgba(255,255,255,0.03); border:1px dashed rgba(255,255,255,0.14);
        max-width:26rem; font-size:0.8rem; color:var(--text-secondary); }
      .floor-age { font-family:ui-monospace,Menlo,monospace; font-size:12.5px; color:var(--accent); margin-left:auto; }
      .floor-dots { display:inline-flex; font-size:14.5px; line-height:1; color:var(--text-secondary); }
      .floor-dots span { animation:blink 1.2s infinite; opacity:0.25; }
      .floor-dots span:nth-child(2) { animation-delay:0.2s; }
      .floor-dots span:nth-child(3) { animation-delay:0.4s; }
      @keyframes blink { 0%,60%,100% { opacity:0.25; } 30% { opacity:1; } }
      .floor-stale { border-style:solid; border-color:rgba(224,134,74,0.35); }
      .floor-stale .floor-dots span { animation:none; opacity:0.25; color:#e0864a; }
      .floor-stale .floor-age { color:#e0864a; }
      @media (prefers-reduced-motion:reduce) { .floor-dots span, .status-live::before { animation:none; opacity:0.6; } }

      .move { margin-top:1.2rem; padding:1.1rem 1.3rem; border:1px solid rgba(63,184,196,0.3); border-left:3px solid var(--status-open); border-radius:6px; background:rgba(63,184,196,0.05); scroll-margin-top:calc(var(--nav-h) + 1rem); }
      .move-kicker { font-family:var(--font-mono); font-size:0.66rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--status-open); }
      .move p { color:var(--text-primary); font-size:0.95rem; margin-top:0.7rem; max-width:38rem; }
      .move-none { border-color:rgba(255,255,255,0.12); border-left-color:var(--text-muted); background:rgba(255,255,255,0.02); }
      .move-none .move-kicker { color:var(--text-muted); }
      .move-none p { color:var(--text-secondary); }
      .turn, details.session { scroll-margin-top:calc(var(--nav-h) + 3.2rem); }

      .page-footer { margin-top:3rem; padding-top:1.5rem; border-top:1px solid rgba(255,255,255,0.06); color:var(--text-muted); font-size:0.85rem; }
      .page-footer a { color:var(--accent); text-decoration:none; }

      /* THE PHONE IS THE FIRST SCREEN. The nav stops being fixed and wraps,
         the chapter heading pins to the top edge, and bubbles go edge to
         edge. */
      @media (max-width:600px){
        :root{--nav-h:0px;}
        main{padding:1rem 0.9rem 4rem;} h1{font-size:2rem;}
        .top-nav{position:static; height:auto; padding:0.6rem 0.9rem; gap:0.6rem; flex-wrap:wrap;}
        .nav-right{gap:0.7rem; margin-left:0; width:100%;}
        .nav-build{display:none;}
        .nav-link{font-size:0.78rem;}
        .fold{padding:0 0.85rem;}
        .session-row{padding:0.8rem 0.9rem;}
        .session-title{font-size:1.3rem;}
        .session-body{padding:0.7rem 0.9rem 1rem;}
        .chapter{margin:0 -0.9rem 0.5rem; padding:0.2rem 0.9rem 0.5rem;}
        .chapter-head{margin:0 -0.9rem 0.7rem; padding:0.5rem 0.9rem;}
        .turn{padding:0.7rem 0.8rem 0.45rem; max-width:none;}
        .turn-head{gap:0.4rem 0.55rem;}
        .floor{max-width:none;}
        .turn, details.session { scroll-margin-top:3.2rem; }
        .move{scroll-margin-top:1rem;}
      }
    </style>
  </body>
</html>
