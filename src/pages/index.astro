---
// Configuration Economics - Living Epistemic Work
// The front door: the whole scope in one view. Seed and Board first (the live
// edge, for a visitor who wants to do something with the work), then every
// surface grouped by what it is for. The map itself is ScopeMap, shared with
// the Overview so the front door and the page after it stay in step.
import { VERSION, BUILD } from '../lib/version';
import PhoneNav from '../components/PhoneNav.astro';
import ScopeMap from '../components/ScopeMap.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Configuration Economics — A Living Epistemic Work</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Sora:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
    <PhoneNav />
    <style>
      :root {
        --void: #0a0a0c;
        --text-primary: #e8e8f0;
        --text-secondary: #a0a0b8;
        --text-muted: #606080;
        --accent: #4a9eff;
        --font-display: 'Cormorant Garamond', serif;
        --font-body: 'Sora', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: var(--font-body); background: var(--void); color: var(--text-primary); min-height: 100vh; line-height: 1.6; }

      .top-nav { position:fixed; top:0; left:0; right:0; height:56px; background:rgba(10,10,12,0.95); backdrop-filter:blur(12px); border-bottom:1px solid rgba(255,255,255,0.06); display:flex; align-items:center; gap:2rem; padding:0 2rem; z-index:100; }
      .nav-home { font-family:var(--font-display); font-size:1.125rem; color:var(--text-primary); text-decoration:none; }
      .nav-link { font-size:0.875rem; color:var(--text-secondary); text-decoration:none; }
      .nav-link:hover { color:var(--accent); }
      .nav-right { display:flex; align-items:center; gap:1rem; margin-left:auto; flex-wrap:wrap; }
      .nav-version { font-family:var(--font-mono); font-size:0.75rem; color:var(--accent); }
      .nav-build { font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); opacity:0.7; }

      main { max-width: 1080px; margin: 0 auto; padding: 120px 2rem 5rem; }
      .hero { max-width: 640px; margin-bottom: 3rem; }
      h1 { font-family: var(--font-display); font-size: 3rem; font-weight: 300; line-height: 1.1; margin-bottom: 0.5rem; }
      .subtitle { font-size: 0.8rem; color: var(--text-muted); letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1.75rem; }
      .claim { font-family: var(--font-display); font-size: 1.45rem; font-style: italic; color: var(--text-primary); line-height: 1.4; margin-bottom: 1.25rem; }
      .note { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.7; }

      .side-note { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.6; max-width: 560px; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.06); }

      @media (max-width: 640px) {
        main { padding-left: 1.25rem; padding-right: 1.25rem; padding-bottom: 3.5rem; }
        h1 { font-size: 2.4rem; }
        .claim { font-size: 1.25rem; }
        .hero { margin-bottom: 2.25rem; }
      }
    </style>
  </head>
  <body>
    <nav class="top-nav">
      <a href="/" class="nav-home">Configuration Economics</a>
      <div class="nav-right">
        <a href="/seed" class="nav-link">Seed</a>
        <a href="/board" class="nav-link">Board</a>
        <a href="/explore" class="nav-link">Propositions</a>
        <a href="/open" class="nav-link">Work</a>
        <span class="nav-version">{VERSION}</span>
        <span class="nav-build">build {BUILD}</span>
      </div>
    </nav>
    <main>
      <header class="hero">
        <h1>Configuration Economics</h1>
        <p class="subtitle">A Living Epistemic Work</p>
        <p class="claim">Value is about what enables future possibilities, not what gets consumed.</p>
        <p class="note">
          A living epistemic work where content can be read at multiple resolutions,
          each claim carries its epistemic status, and an embedded guide helps you
          think through the framework at your own depth.
        </p>
      </header>

      <ScopeMap />

      <p class="side-note">Configuration Economics is my major project for 2026. After this year I'll keep it ticking along, and I hope some of you will come and share the interest.</p>
    </main>
  </body>
</html>
